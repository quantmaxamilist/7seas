---
import { about } from '../../data/site';
import { img } from '../../data/extra';
import Icon from '../site/Icon.astro';
const [lead, ...rest] = about.paragraphs;
---
<section class="about section light" aria-labelledby="about-h">
  <div class="container about__in">
    <div class="about__text">
      <h2 id="about-h" class="label about__k" data-reveal>{about.heading}</h2>
      <p class="statement" data-reveal style="--d:.05s">{lead}</p>
      {rest.map((p, i) => <p class="about__p" data-reveal style={`--d:${0.1 + i * 0.05}s`}>{p}</p>)}
      <a class="btn btn--navy about__btn" href="/gallery" data-reveal>Gallery<Icon name="arrow" /></a>
    </div>
    <div class="about__pics" data-reveal style="--d:.1s">
      <div class="ph about__a"><img src={img('18')} alt="Open-plan kitchen and dining room" width="1024" height="768" loading="lazy" /></div>
      <div class="ph about__b"><img src={img('33')} alt="Single-storey extension under construction" width="768" height="1024" loading="lazy" /></div>
    </div>
  </div>
</section>

<style>
  .about__in { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(2rem, 1rem + 4vw, 6rem); align-items: center; }
  .about__k { color: var(--blue); margin-bottom: var(--s-5); font-weight: 500; }
  .about__p { margin-top: var(--s-5); color: var(--ink-soft); max-width: 58ch; }
  .about__btn { margin-top: var(--s-6); }
  .about__pics { position: relative; aspect-ratio: 1 / 1.05; }
  .about__a { position: absolute; left: 0; top: 0; width: 78%; aspect-ratio: 4 / 3; }
  .about__b { position: absolute; right: 0; bottom: 0; width: 46%; aspect-ratio: 3 / 4; border: 6px solid var(--paper); }
  .about__pics::after { content: ''; position: absolute; left: 8%; bottom: 12%; width: 30%; height: 10px; background: var(--orange); }
  @media (max-width: 860px) { .about__in { grid-template-columns: minmax(0, 1fr); } .about__pics { max-width: 520px; } }
</style>
