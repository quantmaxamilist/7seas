---
import { google } from '../../data/site';
// Short facts lifted from the old site's own copy (About / Services / Free Quote)
const items = ['Across South East of England', 'Daily communication on your project', 'Complies with current building regulations', 'Most of our work comes through referrals'];
---
<div class="proof" aria-label="Why 7 Seas">
  <ul class="container proof__in" role="list">
    <li><a class="proof__g" href={google.mapsUrl} target="_blank" rel="noopener"><span class="proof__star" aria-hidden="true">★</span>{google.rating} on Google · {google.count} reviews</a></li>
    {items.map((t) => <li><span class="proof__tick" aria-hidden="true"></span>{t}</li>)}
  </ul>
</div>

<style>
  .proof { background: var(--navy-2); color: rgba(255, 255, 255, 0.9); border-top: 1px solid var(--line-dark); }
  .proof__in { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-3) var(--s-5); padding-block: var(--s-4); font-size: 0.8125rem; }
  .proof li { display: flex; align-items: center; gap: 0.6em; }
  .proof__g { display: inline-flex; align-items: center; gap: 0.5em; font-weight: 600; text-decoration: none; color: var(--white); }
  .proof__g:hover { text-decoration: underline; }
  .proof__star { color: #fbbc04; font-size: 1.1em; }
  .proof__tick { width: 10px; height: 10px; flex: none; background: var(--orange); clip-path: polygon(50% 0, 100% 55%, 100% 100%, 0 100%, 0 55%); }
  @media (max-width: 760px) { .proof__in { display: grid; grid-template-columns: minmax(0, 1fr); } }
</style>
