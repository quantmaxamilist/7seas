---
import { google } from '../../data/site';
interface Props { tone?: 'dark' | 'light'; size?: 'sm' | 'lg' }
const { tone = 'dark', size = 'sm' } = Astro.props;
---
<a class:list={['gr', `gr--${tone}`, `gr--${size}`]} href={google.mapsUrl} target="_blank" rel="noopener"
  aria-label={`Rated ${google.rating} out of 5 from ${google.count} Google reviews — read them on Google`}>
  <svg class="gr__g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>
  <span class="gr__score">{google.rating}</span>
  <span class="gr__stars" aria-hidden="true">★★★★★</span>
  <span class="gr__count">{google.count} Google reviews</span>
</a>

<style>
  .gr { display: inline-flex; align-items: center; gap: 0.55em; min-height: 44px; padding: 0.35rem 0.9rem 0.35rem 0.5rem; border-radius: 999px; text-decoration: none; font-size: 0.9rem; line-height: 1;
    transition: background var(--dur-1), border-color var(--dur-1); }
  .gr--dark { background: rgba(255, 255, 255, 0.07); border: 1px solid var(--line-dark); color: var(--white); }
  .gr--dark:hover { background: rgba(255, 255, 255, 0.14); }
  .gr--light { background: var(--white); border: 1px solid var(--line); color: var(--ink); }
  .gr--light:hover { border-color: var(--navy); }
  .gr__g { width: 22px; height: 22px; flex: none; }
  .gr__score { font-family: var(--font-display); font-weight: 900; font-stretch: 115%; font-size: 1.05em; }
  .gr__stars { color: #fbbc04; letter-spacing: 0.05em; }
  .gr__count { opacity: 0.8; }
  .gr--lg { font-size: 1.05rem; padding: 0.6rem 1.2rem 0.6rem 0.7rem; }
  .gr--lg .gr__g { width: 30px; height: 30px; }
  .gr--lg .gr__score { font-size: 1.5em; }
</style>
