---
import { img } from '../../data/extra';
// A section drawing of a house: main house (refurbishments), roof space with dormer (loft conversion),
// single-storey side extension (extensions). Lines draw, then the client's own photos fill each zone.
---
<div class="bp" data-bp>
  <svg viewBox="40 30 748 580" role="img" aria-label="Drawing of a house showing refurbishment, extension and loft conversion">
    <defs>
      <clipPath id="bp-loft"><polygon points="140,212 330,72 520,212" /><rect x="392" y="120" width="96" height="92" /></clipPath>
      <clipPath id="bp-gf1"><rect x="146" y="402" width="180" height="146" /></clipPath>
      <clipPath id="bp-gf2"><rect x="334" y="402" width="180" height="146" /></clipPath>
      <clipPath id="bp-ff"><rect x="146" y="222" width="368" height="170" /></clipPath>
      <clipPath id="bp-ext"><polygon points="528,392 708,414 708,548 528,548" /></clipPath>
      <pattern id="bp-grid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" stroke="rgba(255,255,255,.05)" /></pattern>
    </defs>
    <rect x="40" y="30" width="748" height="580" fill="url(#bp-grid)" />

    <!-- photo fills -->
    <g class="bp__fill" data-zone="loft-conversion" clip-path="url(#bp-loft)"><image href={img('30')} x="140" y="60" width="360" height="160" preserveAspectRatio="xMidYMid slice" /><image href={img('40', true)} x="392" y="112" width="96" height="100" preserveAspectRatio="xMidYMid slice" /></g>
    <g class="bp__fill" data-zone="refurbishments" clip-path="url(#bp-ff)"><image href={img('17')} x="146" y="222" width="368" height="170" preserveAspectRatio="xMidYMid slice" /></g>
    <g class="bp__fill" data-zone="refurbishments" clip-path="url(#bp-gf1)" style="--fd:.08s"><image href={img('04', true)} x="146" y="402" width="180" height="146" preserveAspectRatio="xMidYMid slice" /></g>
    <g class="bp__fill" data-zone="refurbishments" clip-path="url(#bp-gf2)" style="--fd:.16s"><image href={img('26', true)} x="334" y="402" width="180" height="146" preserveAspectRatio="xMidYMid slice" /></g>
    <g class="bp__fill" data-zone="extensions" clip-path="url(#bp-ext)" style="--fd:.12s"><image href={img('23')} x="528" y="392" width="180" height="156" preserveAspectRatio="xMidYMid slice" /></g>

    <!-- linework -->
    <g class="bp__lines">
      <path class="ln ground" d="M40 556 H760" />
      <path class="ln" data-zone="refurbishments" d="M140 556 V212 H520 V556 M140 396 H520 M330 396 V556 M140 216 H520" />
      <path class="ln thin" data-zone="refurbishments" d="M180 300 h60 v50 h-60z M420 300 h60 v50 h-60z M230 470 h46 v86" />
      <path class="ln roof" data-zone="loft-conversion" d="M118 228 L330 64 L542 228" />
      <path class="ln roof" data-zone="loft-conversion" d="M384 120 H496 M392 120 V212 M488 120 V170" />
      <path class="ln thin" data-zone="loft-conversion" d="M300 44 v34 h22 v-18" />
      <path class="ln ext" data-zone="extensions" d="M520 386 L716 410 M528 392 V556 M708 414 V556" />
      <path class="ln thin" data-zone="extensions" d="M570 470 h80 v40 h-80z" />
      <path class="ln dim" d="M140 590 H520 M140 584 v12 M520 584 v12 M528 590 H708 M528 584 v12 M708 584 v12" />
    </g>
  </svg>
  <!-- pins (positions in % of the 748x580 viewBox) — no numbers: the list beside is numbered -->
  <button class="pin" data-pin="refurbishments" style="left:38.8%;top:46.6%" aria-label="Refurbishments"></button>
  <button class="pin" data-pin="extensions" style="left:77.3%;top:77.6%" aria-label="Extensions"></button>
  <button class="pin" data-pin="loft-conversion" style="left:38.8%;top:20.7%" aria-label="Loft Conversion"></button>
</div>

<style>
  .bp { position: absolute; inset: 0; }
  .bp svg { width: 100%; height: 100%; }
  .ln { fill: none; stroke: rgba(255, 255, 255, 0.9); stroke-width: 3; stroke-linecap: square; stroke-linejoin: miter; }
  .ln.thin { stroke-width: 1.6; stroke: rgba(255, 255, 255, 0.6); }
  .ln.roof { stroke: var(--orange); stroke-width: 6; }
  .ln.ext { stroke: var(--blue-bright); stroke-width: 5; }
  .ln.ground { stroke: rgba(255, 255, 255, 0.35); stroke-width: 2; }
  .ln.dim { stroke: rgba(255, 255, 255, 0.3); stroke-width: 1.2; }
  .bp__fill { transition: opacity 0.35s; }
  .bp__fill image { filter: saturate(0.9) contrast(1.04); }

  :global(.js) .bp .ln { stroke-dasharray: 1; stroke-dashoffset: 1; }
  :global(.js) .bp .bp__fill { opacity: 0; }
  :global(.js) .bp .bp__fill image { transform-box: fill-box; transform-origin: center; transform: scale(1.15); }
  .bp.play .ln { stroke-dashoffset: 0; transition: stroke-dashoffset 1.1s var(--ease-io); }
  .bp.play .ln.roof { transition-delay: 0.12s; }
  .bp.play .ln.ext { transition-delay: 0.2s; }
  .bp.play .ln.thin { transition-delay: 0.3s; transition-duration: 0.8s; }
  .bp.play .bp__fill { opacity: 1; transition: opacity 0.7s var(--ease-out); transition-delay: calc(1s + var(--fd, 0s)); }
  .bp.play .bp__fill image { transform: none; transition: transform 1.2s var(--ease-out); transition-delay: calc(1s + var(--fd, 0s)); }
  .bp.snap * { transition: none !important; }

  /* highlight */
  :global(.svc[data-hl]:not([data-hl=''])) .bp__fill { opacity: 0.18; }
  :global(.svc[data-hl='refurbishments']) .bp__fill[data-zone='refurbishments'],
  :global(.svc[data-hl='extensions']) .bp__fill[data-zone='extensions'],
  :global(.svc[data-hl='loft-conversion']) .bp__fill[data-zone='loft-conversion'] { opacity: 1; }

  .pin { position: absolute; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; border: 0; padding: 0; background: var(--orange);
    box-shadow: 0 0 0 4px rgba(242, 103, 34, 0.3), 0 4px 14px rgba(0, 0, 0, 0.4); opacity: 0; transform: scale(0.4); pointer-events: none;
    transition: opacity 0.4s, transform 0.4s var(--ease-out), box-shadow var(--dur-2); }
  :global(.svc.done) .pin { opacity: 1; transform: none; pointer-events: auto; }
  :global(.svc[data-hl='refurbishments']) .pin[data-pin='refurbishments'],
  :global(.svc[data-hl='extensions']) .pin[data-pin='extensions'],
  :global(.svc[data-hl='loft-conversion']) .pin[data-pin='loft-conversion'] { box-shadow: 0 0 0 10px rgba(242, 103, 34, 0.35), 0 4px 14px rgba(0, 0, 0, 0.4); transform: scale(1.15); }
</style>

<script>
  import { mountWow } from '../../scripts/wow.js';
  const bp = document.querySelector('[data-bp]');
  const section = bp?.closest('.svc');
  if (bp && section) {
    bp.querySelectorAll('.ln').forEach((p) => p.setAttribute('pathLength', '1'));
    mountWow(section, {
      reset() { bp.classList.add('snap'); bp.classList.remove('play'); void bp.getBoundingClientRect(); bp.classList.remove('snap'); },
      play() { return new Promise((r) => { requestAnimationFrame(() => bp.classList.add('play')); setTimeout(r, 2300); }); },
      finish() { bp.classList.add('play'); },
      highlight() {},
    });
  }
  // pins link to their service page
  document.querySelectorAll('.bp .pin').forEach((p) => p.addEventListener('click', () => { location.href = `/services/${p.dataset.pin}`; }));
</script>
