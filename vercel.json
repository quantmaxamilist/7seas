{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/feed/:path*", "destination": "/", "permanent": true },
    { "source": "/comments/feed/:path*", "destination": "/", "permanent": true },
    { "source": "/wp-sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/wp-sitemap-posts-page-1.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/wp-sitemap-users-1.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/author/:path*", "destination": "/", "permanent": true }
  ]
}
